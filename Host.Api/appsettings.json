{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "CoursesDbConnection": "Server =(localdb)\\MSSQLLocalDB;Database=StepLearning.CoursesDb;TrustServerCertificate = true;Trusted_Connection=True;MultipleActiveResultSets=true",
    "StepLearning.UsersDb": "Server =(localdb)\\MSSQLLocalDB;Database=StepLearning.UsersDb;TrustServerCertificate = true;Trusted_Connection=True;MultipleActiveResultSets=true",
    "StepLearning.EnrollmentsDb": "Server =(localdb)\\MSSQLLocalDB;Database=StepLearning.EnrollmentsDb;TrustServerCertificate = true;Trusted_Connection=True;MultipleActiveResultSets=true",
    "StepLearning.PaymentsDb": "Server =(localdb)\\MSSQLLocalDB;Database=StepLearning.PaymentsDb;TrustServerCertificate = true;Trusted_Connection=True;MultipleActiveResultSets=true"
  },
  "RabbitMq": {
    "Host": "localhost",
